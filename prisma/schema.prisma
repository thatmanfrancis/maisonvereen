// Maison Vereen — Prisma 7 Schema
// NOTE: datasource url is NOT set here in Prisma 7 — it lives in prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Application — full form from DOC-20260617-WA0002 ─────────────────────────
model Application {
  id                String            @id @default(cuid())
  name              String
  email             String
  phone             String?
  country           String
  whatYouDo         String
  howHeard          String            @default("Not specified")
  referredBy        String?
  whatMadeApply     String            @db.Text
  earlyThing        String?           @db.Text
  anythingElse      String?           @db.Text
  consent           Boolean           @default(true)
  status            ApplicationStatus @default(PENDING)
  notes             String?           @db.Text
  membershipCircle  MembershipCircle  @default(FOUNDING)
  houseId           String?
  receiptNo         String?
  amountPaid        Int?
  paymentDeadline   String?
  approvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([approvedAt])
  @@unique([houseId])
  @@unique([receiptNo])
}

// ── Waitlist — email + name + country entry from Waitlist page ───────────────
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Admin users ───────────────────────────────────────────────────────────────
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hash — never store plain text
  name      String
  createdAt DateTime @default(now())
}

// ── Notification Emails — custom recipients managed by admins ───────────────
model NotificationEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum MembershipCircle {
  FOUNDING
  COLLECTORS
  HOUSE
}

// ── Fragrance Enquiry — Signature Collection acquire flow ─────────────────────
model FragranceEnquiry {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String?
  fragrance    String
  fragranceNo  String?
  message      String?       @db.Text
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum EnquiryStatus {
  NEW
  CONTACTED
  COMPLETED
}

// ── Signature Collection — admin-managed bottles + display order ─────────────
model SignatureFragrance {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  notes       String
  description String
  imageSrc    String
  imageAlt    String   @default("")
  sortOrder   Int
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([published])
}

// ── Site settings — singleton for payment / bank details used in emails ──────
model SiteSetting {
  id                 String   @id @default("default")
  bankName           String   @default("")
  accountName        String   @default("")
  accountNumber      String   @default("")
  paymentNote        String?  @db.Text
  releaseLabel       String   @default("Edition One — 2027")
  releaseDate        String   @default("29 May 2027")
  amountNaira        Int      @default(430000)
  foundingDeadline   String   @default("2 weeks")
  collectorsDeadline String   @default("1 month")
  houseDeadline      String   @default("1 month 2 weeks")
  updatedAt          DateTime @updatedAt
}
